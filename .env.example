# Telegram bot token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN

# Telegram numeric user IDs allowed to administer the bot (comma-separated)
ADMIN_IDS=123456789

# Admin website login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Local development uses SQLite. For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://xarmy:CHANGE_DB_PASSWORD@db:5432/xarmy
DATABASE_URL=sqlite:///./data/xarmy.db

# Referral and package rules
REFERRAL_REWARD=10
PACKAGE_1H_POINTS=30
PACKAGE_2H_POINTS=50
PACKAGE_3H_POINTS=70

# Public bot username without @, e.g. TheXArmyReferralBot
BOT_USERNAME=
